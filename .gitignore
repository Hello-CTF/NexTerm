node_modules
dist
target

# 历史遗留的备用构建目录，防止误提交
target-alt
src-tauri/target
src-tauri/gen/schemas

*.log
.DS_Store

# pnpm 写 store 时的硬链接中间产物（0 字节、链接数 2），正常应自删；
# 构建被打断时会滞留在项目根，不该进版本控制。同 inode 的兄弟在 ~/Library/pnpm/_tmp_*/。
_tmp_*

# 构建校验输出目录
.buildcheck

# 本地站点预览目录
.sitetest

# 本地设计稿，不入库
docs/PLAN-*

# 本地工作笔记 / 会话记忆，不入库
.workbuddy/
