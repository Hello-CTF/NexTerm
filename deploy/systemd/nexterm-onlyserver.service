[Unit]
Description=NexTerm server (sync-only asset synchronization peer)
Documentation=https://github.com/Hello-CTF/NexTerm
After=network-online.target
Wants=network-online.target
Conflicts=nexterm-server.service

[Service]
Type=simple
User=nexterm
Group=nexterm

EnvironmentFile=/etc/nexterm/onlyserver.env

ExecStart=/opt/nexterm/nexterm-server --sync-only

Restart=on-failure
RestartSec=3
TimeoutStopSec=60

Environment=HOME=/var/lib/nexterm
WorkingDirectory=/var/lib/nexterm
StateDirectory=nexterm
StateDirectoryMode=0700
UMask=0077
LimitNOFILE=1048576

# The sync-only peer only serves HTTP, writes its data directory and reaches
# remote databases, so it runs fully sandboxed. Everything outside
# /var/lib/nexterm is read-only; install.sh adds ReadWritePaths= (and relaxes
# ProtectHome) in nexterm-onlyserver.service.d/50-nexterm-paths.conf when
# onlyserver.env points elsewhere. Binding a port below 1024 needs a drop-in
# with AmbientCapabilities=CAP_NET_BIND_SERVICE and
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RemoveIPC=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible

[Install]
WantedBy=multi-user.target
