[Unit]
Description=NexTerm server (browser-based development and operations terminal)
Documentation=https://github.com/Hello-CTF/NexTerm
After=network-online.target
Wants=network-online.target
Conflicts=nexterm-onlyserver.service

[Service]
Type=simple
User=nexterm
Group=nexterm

EnvironmentFile=/etc/nexterm/nexterm.env

ExecStart=/opt/nexterm/nexterm-server

Restart=on-failure
RestartSec=3
TimeoutStopSec=60
# KillMode stays at the default (control-group) on purpose. Without accounts
# (NEXTERM_AUTH=off) the server runs local terminals in a detached local
# helper; stopping or restarting this service ends that helper and its
# terminals with the rest of the service's processes. KillMode=process would
# keep them, but would also leave every other child of the server behind.

Environment=HOME=/var/lib/nexterm
WorkingDirectory=/var/lib/nexterm
StateDirectory=nexterm
StateDirectoryMode=0700
UMask=0077
LimitNOFILE=1048576

# Sandboxing stops at what open-access local terminals and sshfs mounts keep
# working with, because terminal programs inherit it: a read-only filesystem,
# hidden /dev/pts or /dev/fuse, a blocked setuid fusermount3 or sudo, or no
# W+X memory for JIT runtimes would break them. deploy/systemd/README.md
# lists a stricter drop-in for servers with accounts on.
ProtectSystem=full
PrivateTmp=yes
ProtectHostname=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
