[Unit]
Description=NexTerm 服务端（浏览器版开发运维终端）
Documentation=https://github.com/Hello-CTF/NexTerm
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nexterm
Group=nexterm

EnvironmentFile=-/etc/nexterm/nexterm.env

ExecStart=/opt/nexterm/nexterm-server \
  --listen 127.0.0.1:8080 \
  --auth on \
  --data-dir /var/lib/nexterm \
  --web-root /opt/nexterm/web

Restart=on-failure
RestartSec=3

Environment=HOME=/var/lib/nexterm
WorkingDirectory=/var/lib/nexterm
StateDirectory=nexterm

[Install]
WantedBy=multi-user.target
