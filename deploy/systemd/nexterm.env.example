# Install as /etc/nexterm/nexterm.env with mode 0600.
NEXTERM_LISTEN=127.0.0.1:8080
NEXTERM_AUTH=on
NEXTERM_DATA_DIR=/var/lib/nexterm
NEXTERM_WEB_ROOT=/opt/nexterm/web
NEXTERM_MASTER_KEY_FILE=/etc/nexterm/master.key
NEXTERM_DB=sqlite

# If a TLS reverse proxy forwards to this server, make it overwrite
# X-Forwarded-Proto and list only the proxy's own addresses here (comma
# separated). This only trusts X-Forwarded-Proto.
# NEXTERM_TRUSTED_PROXY_CIDRS=127.0.0.1/32
# Connections through an ssh -L tunnel also arrive from 127.0.0.1, so anyone
# with such a tunnel is trusted like the proxy when 127.0.0.1 is listed.
# To rate limit logins and record sessions by real client address, also trust
# X-Forwarded-For. The proxy may overwrite or append to it (nginx:
# $remote_addr or $proxy_add_x_forwarded_for) but must not pass the client's
# value through unchanged; list every hop of chained proxies above.
# NEXTERM_TRUST_FORWARDED_FOR=1

# For PostgreSQL, MySQL or MariaDB, change NEXTERM_DB and set NEXTERM_DB_DSN.
# postgres: postgres://nexterm@db.example:5432/nexterm?sslmode=verify-full
# mysql/mariadb: nexterm@tcp(db.example:3306)/nexterm?parseTime=true&tls=true
# NEXTERM_DB_DSN=
# Store a remote database password in a separate 0600 file readable by nexterm;
# do not put it in both the DSN and NEXTERM_DB_PASSWORD_FILE.
# NEXTERM_DB_PASSWORD_FILE=/etc/nexterm/db-password
# NEXTERM_DB_MAX_OPEN_CONNS=16
