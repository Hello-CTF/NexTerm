    "eslint": "^10.12.0",
    "jsdom": "30.1.2",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "5.0.3"
  }
