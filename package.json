{
  "name": "nexterm",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node --max-old-space-size=4096 node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "preview": "vite preview",
    "build:app": "node scripts/build.mjs",
    "build:release": "node scripts/build.mjs release"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-sql": "^6.2.1",
    "@codemirror/language": "^6.10.8",
    "@codemirror/legacy-modes": "^6.4.2",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.4",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-virtual": "^3.13.0",
    "@wailsio/runtime": "3.0.0-beta.27",
    "@xterm/addon-fit": "0.12.0-beta.311",
    "@xterm/addon-search": "0.17.0-beta.310",
    "@xterm/addon-web-links": "0.13.0-beta.310",
    "@xterm/addon-webgl": "0.20.0-beta.309",
    "@xterm/xterm": "6.1.0-beta.315",
    "codemirror": "^6.0.2",
    "fzstd": "^0.1.1",
    "lucide-react": "^1.53.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "30.1.2",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "5.0.3"
  }
}
