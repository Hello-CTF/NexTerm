# basic ssh config fixture
# comment lines and blank lines are ignored

Host web
    HostName web.example.com
    Port 2222
    User deploy
    IdentityFile ~/.ssh/id_ed25519
    ProxyJump bastion

Host bastion
    HostName bastion.example.com
    User admin

# key=value form, quoted identity file, first value wins
Host db
    HostName = db.example.com
    Port = 5432
    Port 9999
    User = "dbuser"
    IdentityFile "~/.ssh/db key"
    IdentityFile ~/.ssh/db key

Host multi one
    HostName multi.example.com
